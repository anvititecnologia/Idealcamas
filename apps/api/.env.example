# ──────────────────────────────────────────────────────────────────────────────
# Ideal Camas — Variáveis de Ambiente
# ──────────────────────────────────────────────────────────────────────────────
# COPIE PARA .env E PREENCHA OS VALORES REAIS.
# NUNCA COMMITE O ARQUIVO .env NO REPOSITÓRIO.
# ──────────────────────────────────────────────────────────────────────────────

# ── Banco de Dados ──
DATABASE_URL="postgresql://user:password@localhost:5432/idealcamas?schema=public"

# ── JWT ──
JWT_SECRET="GERAR_COM_openssl_rand_-hex_64"
JWT_EXPIRES_IN="8h"

# ── AWS S3 (Buckets Isolados) ──
AWS_REGION="sa-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_MODELS="idealcamas-models-prod"
S3_BUCKET_TEXTURES="idealcamas-textures-prod"
S3_BUCKET_THUMBNAILS="idealcamas-thumbnails-prod"

# ── URLs dos Frontends (CORS) ──
CLIENT_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3002"

# ── Google Maps API (Cálculo de Frete) ──
GOOGLE_MAPS_API_KEY=""
FREIGHT_ORIGIN_ADDRESS="Endereço da fábrica aqui"
FREIGHT_PERCENT_PER_10KM="30"

# ── WhatsApp ──
WHATSAPP_NUMBER="5511999999999"

# ── Server ──
PORT=3001
NODE_ENV="development"
